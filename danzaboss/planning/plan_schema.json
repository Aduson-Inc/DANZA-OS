{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DANZABOSS plan",
  "description": "Authoritative internal execution plan. New product-linked atomic leaves use ids such as 71-A; legacy dotted task trees remain readable.",
  "type": "object",
  "required": ["spec_ref", "tasks"],
  "properties": {
    "spec_ref": {"type": "string", "description": "path/hash of the spec this plan derives from"},
    "order": {"type": "array", "items": {"type": "string"}, "description": "leaf ids in validated execution order (written by the workstation planner)"},
    "tasks": {"type": "array", "items": {"$ref": "#/definitions/task"}},
    "execution": {
      "type": "object",
      "description": "mutable per-unit status/timing ledger keyed by ordered leaf id",
      "additionalProperties": {"$ref": "#/definitions/execution_record"}
    },
    "calibration": {
      "type": "array",
      "description": "append-only estimate-versus-actual observations",
      "items": {"$ref": "#/definitions/calibration_observation"}
    }
  },
  "definitions": {
    "execution_record": {
      "type": "object",
      "required": ["status", "started_at", "completed_at", "actual_minutes", "verification_attempts", "verification_passed", "verification_evidence", "blocker_reason", "completed_turn"],
      "properties": {
        "status": {"enum": ["pending", "in_progress", "blocked", "completed"]},
        "started_at": {"type": ["string", "null"]},
        "completed_at": {"type": ["string", "null"]},
        "actual_minutes": {"type": ["number", "null"], "minimum": 0},
        "verification_attempts": {"type": "integer", "minimum": 0},
        "verification_passed": {"type": "boolean"},
        "verification_evidence": {
          "type": "array",
          "items": {"$ref": "#/definitions/verification_evidence"}
        },
        "blocker_reason": {"type": ["string", "null"]},
        "completed_turn": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "verification_evidence": {
      "type": "object",
      "required": ["command", "passed", "exit_code", "stdout_tail", "stderr_tail", "timed_out", "recorded_at"],
      "properties": {
        "command": {"type": "string"},
        "passed": {"type": "boolean"},
        "exit_code": {"type": "integer"},
        "stdout_tail": {"type": "string"},
        "stderr_tail": {"type": "string"},
        "timed_out": {"type": "boolean"},
        "recorded_at": {"type": "string"}
      },
      "additionalProperties": false
    },
    "calibration_observation": {
      "type": "object",
      "required": ["unit_id", "estimated_minutes", "actual_minutes", "variance_minutes", "overrun", "recorded_at"],
      "properties": {
        "unit_id": {"type": "string"},
        "estimated_minutes": {"type": "number", "minimum": 0},
        "actual_minutes": {"type": "number", "minimum": 0},
        "variance_minutes": {"type": "number"},
        "overrun": {"type": "boolean"},
        "recorded_at": {"type": "string"}
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "anyOf": [{"pattern": "^[1-9]\\d*-[A-Z]$"}, {"pattern": "^\\d+(\\.\\d+){0,2}$"}], "description": "product-linked atomic id (71-A) or legacy dotted id"},
        "description": {"type": "string", "description": "ONE concern; conjunction chains are rejected by the validator"},
        "feature_id": {"type": "integer", "minimum": 1, "description": "approved numeric product feature id; required for atomic ids"},
        "kind": {"enum": ["scaffold", "backend", "frontend", "db-migration", "integration", "config", "design", "test"]},
        "size_est": {"type": "integer", "minimum": 1, "maximum": 30, "description": "estimated minutes; legacy dotted plans allow up to 30"},
        "depends_on": {"type": "array", "items": {"type": "string"}, "description": "task ids that must complete first (leaves only)"},
        "writes": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "maxItems": 3, "description": "non-empty files/areas touched; kept for wave planning"},
        "flags": {"type": "array", "items": {"enum": ["auth", "payment", "db-schema"]}, "description": "hard-stop markers surfaced at planning time (Rules 13-15)"},
        "verification": {
          "type": ["object", "null"],
          "required": ["kind", "detail"],
          "properties": {
            "kind": {"enum": ["automated_test", "command_output", "http_check", "schema_check", "manual_gate"]},
            "detail": {"type": "string", "minLength": 1}
          }
        },
        "subtasks": {"type": "array", "items": {"$ref": "#/definitions/task"}}
      },
      "allOf": [{
        "if": {"properties": {"id": {"pattern": "^\\d+-[A-Z]$"}}},
        "then": {
          "required": ["feature_id", "kind", "size_est", "writes", "verification"],
          "properties": {
            "size_est": {"minimum": 1, "maximum": 20},
            "subtasks": {"maxItems": 0}
          }
        }
      }]
    }
  }
}
